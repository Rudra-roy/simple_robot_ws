<?xml version="1.0"?>
<robot name="drubotara" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find uirover_description)/xacro/drubotara_description.xacro"/>
    <xacro:include filename="$(find uirover_description)/xacro/materials.xacro"/>
    <xacro:include filename="$(find uirover_description)/xacro/drubotara_gazebo.xacro"/>
    <xacro:include filename="$(find uirover_description)/xacro/ros2_control.xacro"/>
    <xacro:include filename="$(find uirover_description)/xacro/sensors.urdf.xacro"/>
</robot>
